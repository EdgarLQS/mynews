{
  "$defs": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "authors": {
          "items": {
            "maxLength": 200,
            "type": "string"
          },
          "maxItems": 20,
          "type": "array",
          "uniqueItems": true
        },
        "candidateRef": {
          "maxLength": 420,
          "minLength": 3,
          "type": "string"
        },
        "comments": {
          "minimum": 0,
          "type": "integer"
        },
        "contentExcerpt": {
          "maxLength": 6000,
          "type": "string"
        },
        "duplicateGroupId": {
          "maxLength": 200,
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "maxItems": 20,
          "type": "array"
        },
        "externalLinks": {
          "items": {
            "$ref": "#/$defs/url"
          },
          "maxItems": 5,
          "type": "array",
          "uniqueItems": true
        },
        "extractionStatus": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "firstSeenAt": {
          "format": "date-time",
          "type": "string"
        },
        "firstSeenPrecision": {
          "enum": [
            "date",
            "datetime"
          ]
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "idScope": {
          "enum": [
            "global",
            "batch"
          ]
        },
        "imageCandidates": {
          "items": {
            "$ref": "#/$defs/imageCandidate"
          },
          "maxItems": 3,
          "type": "array"
        },
        "language": {
          "maxLength": 35,
          "type": "string"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "multiSources": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "publicationHistory": {
          "items": {
            "$ref": "#/$defs/publication"
          },
          "maxItems": 50,
          "type": "array"
        },
        "publishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "repeat_count": {
          "minimum": 1,
          "type": "integer"
        },
        "source": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "sourceHeat": {
          "minimum": 0,
          "type": "number"
        },
        "sourceRole": {
          "enum": [
            "benchmark",
            "discovery",
            "incident",
            "manual",
            "monitor",
            "primary",
            "research"
          ]
        },
        "summaryOriginal": {
          "maxLength": 2000,
          "type": "string"
        },
        "tags": {
          "items": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 30,
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "id",
        "title",
        "url",
        "source",
        "firstSeenAt"
      ],
      "type": "object"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "publishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "source": {
          "maxLength": 200,
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "type": "string"
        },
        "type": {
          "enum": [
            "source",
            "official",
            "paper",
            "repository",
            "secondary"
          ]
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "type": "object"
    },
    "imageCandidate": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "maxLength": 100,
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "url",
        "type"
      ],
      "type": "object"
    },
    "match": {
      "additionalProperties": false,
      "properties": {
        "databaseMatched": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "dedup_key",
            "normalized_url",
            "fallback"
          ]
        }
      },
      "required": [
        "method",
        "databaseMatched"
      ],
      "type": "object"
    },
    "publication": {
      "additionalProperties": false,
      "properties": {
        "date": {
          "format": "date",
          "type": "string"
        },
        "platform": {
          "maxLength": 100,
          "type": "string"
        },
        "publishedAt": {
          "format": "date-time",
          "type": "string"
        },
        "url": {
          "$ref": "#/$defs/url"
        }
      },
      "required": [
        "date",
        "platform",
        "url",
        "publishedAt"
      ],
      "type": "object"
    },
    "stats": {
      "additionalProperties": false,
      "properties": {
        "candidateCount": {
          "maximum": 500,
          "minimum": 0,
          "type": "integer"
        },
        "databaseMatchedCount": {
          "maximum": 500,
          "minimum": 0,
          "type": "integer"
        },
        "fallbackCount": {
          "maximum": 500,
          "minimum": 0,
          "type": "integer"
        },
        "matchRate": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "candidateCount",
        "databaseMatchedCount",
        "fallbackCount",
        "matchRate"
      ],
      "type": "object"
    },
    "url": {
      "maxLength": 2048,
      "minLength": 8,
      "pattern": "^https?://",
      "type": "string"
    }
  },
  "$id": "https://mynews.local/schemas/candidate-contract-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "maxItems": 500,
      "type": "array"
    },
    "date": {
      "format": "date",
      "type": "string"
    },
    "generatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "stats": {
      "$ref": "#/$defs/stats"
    }
  },
  "required": [
    "schemaVersion",
    "date",
    "generatedAt",
    "candidates"
  ],
  "title": "mynews Candidate Contract v1",
  "type": "object"
}
